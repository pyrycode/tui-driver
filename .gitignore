# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
tui-driver
/spike-one-turn
/spike-cancel
/spike-permission
/spike-multi-turn
/spike-multiselect
/spike-ask-user
/spike-long-prompt
/spike-queued-modals
/probe-first-prompt-hang
/probe-cwd-encoding
/repro-permission-flake
/e2e-runner
/e2e-snapshot-check
/bin/
/e2e-report.json

# Capture logs (e.g. code-review's `make e2e` capture); never commit
*.log

# asciinema session recordings (SpawnOpts.RecordTo); may contain secrets
*.cast
# Exception: hand-authored, secret-free .cast fixtures for the corpus-replay
# harness (#227) and corpus-sampler (#255). Synthetic content only — not real
# recordings.
!cmd/corpus-replay/testdata/*.cast
!cmd/corpus-sampler/testdata/*.cast

# Test
*.test
*.out
coverage.txt

# Go workspace
go.work
go.work.sum

# IDE
.idea/
.vscode/
*.swp
*.swo

# macOS
.DS_Store

# Local config
.env
.env.local

# CodeGraph index (per-machine; populated by `codegraph init -i` + refreshed
# automatically by the dispatcher's post-merge hook on agent-driven changes)
.codegraph

# Dispatcher's per-target lock file (prevents two dispatchers from racing the
# same target repo).
.dispatcher.lock
